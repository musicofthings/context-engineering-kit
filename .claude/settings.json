{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "bash_path": "bash",
  "permissions": {
    "allow": [
      "Write(./session_handover.md)",
      "Edit(./session_handover.md)",
      "Write(./CLAUDE.md)",
      "Edit(./CLAUDE.md)",
      "Write(./agents.md)",
      "Edit(./agents.md)",
      "Write(./briefs/*.md)",
      "Write(./.claude/session/state.json)",
      "Write(./.claude/session/history.jsonl)",
      "Write(./.claude/session/turn-ledger.jsonl)",
      "Write(./.claude/session/usage.jsonl)",
      "Write(./.claude/session/tool-failures.jsonl)",
      "Write(./.claude/session/subagents.jsonl)",
      "Write(./.claude/compact-audit.log)",
      "Write(./.claude/config-audit.log)",
      "Bash(python3 scripts/generate_session_handover.py*)",
      "Bash(python3 scripts/update_context_files.py*)",
      "Bash(python3 scripts/usage-tracker.py*)",
      "Bash(python scripts/generate_session_handover.py*)",
      "Bash(python scripts/update_context_files.py*)",
      "Bash(python scripts/usage-tracker.py*)",
      "Bash(bash scripts/session_sync.sh*)",
      "Bash(bash .claude/hooks/*.sh*)",
      "Bash(git add .claude/session/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./production.*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/morning-brief-auto.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compact-restore.sh"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-title.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto-approve-permissions.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/usage-sentinel.sh",
            "async": false
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-compact.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-compact.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/extract-state-on-stop.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "bash -c 'source \"$CLAUDE_PROJECT_DIR/scripts/find_python.sh\" && \"$PYTHON\" \"$CLAUDE_PROJECT_DIR/scripts/usage-tracker.py\"'",
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-end.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-dangerous.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/track-changes.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-tool-failure.sh",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOK_EVENT=SubagentStart bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/subagent-lifecycle.sh",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOK_EVENT=SubagentStop bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/subagent-lifecycle.sh",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-failure.sh",
            "async": true
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/instructions-loaded.sh",
            "async": true
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "config/model_thresholds.json|config/usage_budget.json|config/plugin_settings.json",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'echo \"[cek] Config file changed: $CLAUDE_FILE_PATH \u2014 thresholds reloaded\" >&2'",
            "async": true
          }
        ]
      }
    ]
  },
  "env": {
    "CEK_VERSION": "2.6.0",
    "CEK_TOKEN_WARN_PCT": "70",
    "CEK_TOKEN_COMPACT_PCT": "85",
    "CEK_TOKEN_CRITICAL_PCT": "92",
    "CEK_MODEL_HAIKU": "claude-haiku-4-5-20251001",
    "CEK_MODEL_SONNET": "claude-sonnet-4-6",
    "CEK_MODEL_OPUS": "claude-opus-4-8",
    "CEK_SUBSCRIPTION_TIER": "pro"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/statusline.sh\""
  }
}