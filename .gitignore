# Secrets & credentials
.env
.env.*
*.pem
*.key
*.p12
secrets/
credentials/

# Session history and per-session append-only logs.
# state.json is committed (it's the cross-device handover anchor); these
# rotate every session and would otherwise produce a perpetually-dirty tree.
.claude/session/history.jsonl
.claude/session/tool-failures.jsonl
.claude/session/turn-ledger.jsonl
.claude/session/usage.jsonl
.claude/session/subagents.jsonl
.claude/session/instructions-loaded.jsonl
.claude/session/daily-usage.json
.claude/session/usage-forecast.json
.claude/session/docs-refresh.log
.claude/session/compact-history/

# Audit logs (local only)
.claude/config-audit.log
.claude/compact-audit.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node / npm
node_modules/
dist/
build/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/settings.json
.idea/
*.swp

# API docs — a local `scripts/fetch_api_docs.py` run writes this file but it
# stays invisible to git (expected, not a bug). It is committed ONLY by the
# sync-api-docs CI workflow, which force-adds it (git add -f) on a bot PR branch.
api_docs.md

# Daily morning briefs (generated locally, not committed)
briefs/

# But DO commit these session files:
!.claude/session/state.json

# Local settings (machine-specific, not committed)
.claude/settings.local.json

# Usage sentinel state files (session-local)
.claude/session/.sentinel_*

# Hook de-dupe guard markers (machine-local, written by hook_once)
.claude/session/.hookfire_*

# state.json concurrency locks (machine-local, never commit)
.claude/session/*.lock
.claude/session/*.lockd
.claude/session/*.lockd/

# Worktrees managed by Claude Code — never commit
.claude/worktrees/

# Distribution artifacts (regenerated by scripts/package_plugin.py)
*.zip
