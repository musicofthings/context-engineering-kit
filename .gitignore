# Secrets & credentials
.env
.env.*
*.pem
*.key
*.p12
secrets/
credentials/

# ALL session state is machine-local and untracked (see 90545c6 "chore: ignore
# Claude session state"). session_handover.md is the portable cross-device
# anchor — it is generated FROM state.json and it IS committed. state.json
# itself rotates every turn and would produce a perpetually-dirty tree.
.claude/session/history.jsonl
.claude/session/tool-failures.jsonl
.claude/session/turn-ledger.jsonl
.claude/session/usage.jsonl
.claude/session/subagents.jsonl
.claude/session/instructions-loaded.jsonl
.claude/session/daily-usage.json
.claude/session/usage-forecast.json
.claude/session/state.json
.claude/session/docs-refresh.log
.claude/session/compact-history/

# Audit logs (local only)
.claude/config-audit.log
.claude/compact-audit.log

# Python
__pycache__/
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node / npm
node_modules/
dist/
build/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/settings.json
.idea/
*.swp

# API docs — a local `scripts/fetch_api_docs.py` run writes this file but it
# stays invisible to git (expected, not a bug). It is committed ONLY by the
# sync-api-docs CI workflow, which force-adds it (git add -f) on a bot PR branch.
api_docs.md

# Daily morning briefs (generated locally, not committed)
briefs/

# Local settings (machine-specific, not committed)
.claude/settings.local.json

# Usage sentinel state files (session-local)
.claude/session/.sentinel_*

# Hook de-dupe guard markers (machine-local, written by hook_once)
.claude/session/.hookfire_*

# state.json concurrency locks (machine-local, never commit)
session_handover.md.lock
.claude/session/*.lock
.claude/session/*.lockd
.claude/session/*.lockd/

# Worktrees managed by Claude Code — never commit
.claude/worktrees/

# Distribution artifacts (regenerated by scripts/package_plugin.py)
*.zip

# Local multi-agent adapters (Grok skills mirror, Codex/Antigravity local state).
# Portable hook wiring IS tracked: .codex/hooks.json + run.sh,
# .grok/hooks/cek-hooks.json + run.sh, .agents/hooks.json + run.sh.
.agents/**
!.agents/hooks.json
!.agents/hooks/
!.agents/hooks/run.sh
!.agents/hooks/README.md
!.agents/plugins/


# Ignore local Codex cache/state, but keep portable wiring tracked.
# (Windows is case-insensitive — do not also ignore `.Codex/` wholesale.)
.codex/**
!.codex/hooks.json
!.codex/hooks/
!.codex/hooks/run.sh
!.codex/hooks/README.md
