{
  "cek": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash .agents/hooks/run.sh session-start",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/run.sh hook guard-dangerous.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/run.sh hook track-changes.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash .agents/hooks/run.sh stop",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash .agents/hooks/run.sh pre-invocation",
        "timeout": 30
      }
    ]
  }
}
